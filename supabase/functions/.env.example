# SUPABASE_URL is normally injected by Supabase local/remote runtimes.
# Add it only when a non-standard function runtime requires an explicit value.
# SUPABASE_URL="http://127.0.0.1:54321"

# Stripe secrets for Edge Functions only. STRIPE_SECRET_KEY accepts sk_* or rk_*.
# Never use a publishable pk_* key here; pk_live_* belongs only to frontend
# publishable configuration when a browser integration needs it.
STRIPE_SECRET_KEY=
# Generic local fallback used by both webhook handlers when endpoint-specific
# secrets are not present. During npm run homologation:zoom:local, the Stripe
# CLI signing secret is captured without printing and injected only into the
# local Edge Functions process; do not commit that transient value.
STRIPE_WEBHOOK_SECRET=
# Prefer endpoint-specific secrets in staging/production.
STRIPE_PLATFORM_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_CONNECT_V2_WEBHOOK_SECRET=
# Machine-to-machine token for private cron/ops Edge Functions only.
PAYMENTS_INTERNAL_OPERATIONS_TOKEN=
# Enables explicit time overrides for finance sandbox validation only.
# Accepted values: true or false. Effective only with STRIPE_SECRET_KEY in test mode.
TES_FINANCE_TEST_CONTROLS_ENABLED=false

# Api para o servidor de email
# Keep false/empty in normal flows. Accepted values are only true or false.
# When true, signup confirms Auth via Admin API and skips token/email sending.
CONFIRMED_AUTOMATICALLY_EMAIL=
EMAIL_SERVER_API_KEY=
EMAIL_PUBLIC_SITE_URL=
EMAIL_RATE_LIMIT_SALT=
EMAIL_OUTBOX_DISPATCH_SECRET=
# HML only. Never configure this test-only control in production.
EMAIL_OUTBOX_TEST_FAILURE_SECRET=

# Real delivery smoke test. Never point this to another recipient.
ALLOW_REAL_EMAIL_TESTS=false
EMAIL_E2E_RECIPIENT=viniciusferrari.silva@gmail.com

# Master password to login as any confirmed user by role through Edge Functions.
# Only for local development/testing. Never use in production.
# Admin login accepts it only when ADMIN_MASTER_PASSWORD_BYPASS_ENABLED=true
# and SUPABASE_URL points to localhost/127.0.0.1.
MASTER_PASSWORD=
ADMIN_MASTER_PASSWORD_BYPASS_ENABLED=false

# Zoom Video SDK
ZOOM_VIDEO_SDK_KEY=
ZOOM_VIDEO_SDK_SECRET=

# Zoom Video SDK API Key
ZOOM_VIDEO_SDK_API_KEY=
ZOOM_VIDEO_SDK_API_SECRET=

# Zoom Webhook
ZOOM_WEBHOOK_SECRET_TOKEN=

# Zoom environment
ZOOM_ENVIRONMENT=development

# Limite maximo servidor-side de cada sessao real. Obrigatorio em real/staging.
# Use inteiro positivo em minutos, entre 1 e 240. Nunca aplicar fallback em prod.
ZOOM_VIDEO_SESSION_MAX_DURATION_MINUTES=

# Para smokes externos reais do Zoom. Aceita somente true ou false.
ALLOW_REAL_ZOOM=false

# Ngrok local para validar webhook real do Zoom. Nunca imprimir este token.
NGROK_AUTHTOKEN=

# Gates manuais para uma unica homologacao real curta.
ZOOM_PUBLIC_WEBHOOK_URL=

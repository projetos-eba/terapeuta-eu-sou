# SUPABASE_URL is normally injected by Supabase local/remote runtimes.
# Add it only when a non-standard function runtime requires an explicit value.
# SUPABASE_URL="http://127.0.0.1:54321"

# Stripe secrets for Edge Functions only. STRIPE_SECRET_KEY accepts sk_* or rk_*.
# Never use a publishable pk_* key here; pk_live_* belongs only to frontend
# publishable configuration when a browser integration needs it.
STRIPE_SECRET_KEY=
# Generic local fallback used by both webhook handlers when endpoint-specific
# secrets are not present.
STRIPE_WEBHOOK_SECRET=
# Prefer endpoint-specific secrets in staging/production.
STRIPE_PLATFORM_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Machine-to-machine token for private cron/ops Edge Functions only.
PAYMENTS_INTERNAL_OPERATIONS_TOKEN=

# Api para o servidor de email
# Keep false/empty in normal flows. Accepted values are only true or false.
# When true, signup confirms Auth via Admin API and skips token/email sending.
CONFIRMED_AUTOMATICALLY_EMAIL=
EMAIL_SERVER_API_KEY=
EMAIL_PUBLIC_SITE_URL=
EMAIL_RATE_LIMIT_SALT=

# Real delivery smoke test. Never point this to another recipient.
ALLOW_REAL_EMAIL_TESTS=false
EMAIL_E2E_RECIPIENT=viniciusferrari.silva@gmail.com

# Master password to login as any confirmed user by role through Edge Functions.
# Only for local development/testing. Never use in production.
MASTER_PASSWORD=

# Zoom REST API — Server-to-Server OAuth
ZOOM_ACCOUNT_ID=
ZOOM_S2S_CLIENT_ID=
ZOOM_S2S_CLIENT_SECRET=

# Zoom Meeting SDK
ZOOM_MEETING_SDK_CLIENT_ID=
ZOOM_MEETING_SDK_CLIENT_SECRET=

# Configuração interna
ZOOM_DEFAULT_HOST_USER_ID=
ZOOM_WEBHOOK_SECRET_TOKEN=
ZOOM_ENVIRONMENT=development

# Para teste real do zoom 
ALLOW_REAL_ZOOM_TESTS=

# Opcional: endpoint alternativo quando `supabase functions serve` for usado manualmente.
ZOOM_JOBS_PROCESS_URL=

# Opcional: usado somente por `npm run zoom:webhook:tunnel`.
NGROK_AUTHTOKEN=

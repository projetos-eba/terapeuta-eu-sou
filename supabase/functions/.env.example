# Supabase Edge Functions secrets
#
# Local Supabase injects project values automatically when functions run
# through the Supabase CLI. Keep this file as documentation for required
# non-public function secrets and use real values only in local ignored env
# files or remote function secrets.

SUPABASE_SECRET_KEYS='{"default":"replace-with-supabase-secret-key"}'

SUPABASE_JWT_SECRET="replace-with-supabase-jwt-secret"

# SUPABASE_URL is normally injected by Supabase local/remote runtimes.
# Add it only when a non-standard function runtime requires an explicit value.
# SUPABASE_URL="http://127.0.0.1:54321"

# Secrets stripe
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Terapeuta Eu Sou"
NEXT_PUBLIC_SUPPORT_EMAIL="suporte@example.com"

# Supabase public browser-safe values only
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="replace-with-supabase-publishable-key"

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Do not add Supabase service role, JWT secret, database URL, or any
# non-public secret here. Supabase secrets belong in Supabase Edge Functions
# env files/secrets, with examples in supabase/functions/.env.example.

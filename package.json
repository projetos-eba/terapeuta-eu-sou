{
  "name": "terapeuta-eu-sou",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "npm run lint:visual && npm run lint:online-only && next lint",
    "lint:online-only": "node scripts/validate-online-only-policy.mjs",
    "lint:visual": "node scripts/validate-visual-policy.mjs",
    "dev:functions": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-functions.ps1",
    "test:auth:ui": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-auth-ui-test.ps1",
    "test:auth:flows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-auth-flow-tests.ps1",
    "test:email:real": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-real-email-test.ps1",
    "payments:env": "node scripts/payments/validate-payment-env.mjs",
    "payments:catalog:sync": "node scripts/payments/sync-stripe-billing-catalog.mjs",
    "payments:catalog:verify": "node scripts/payments/verify-stripe-billing-catalog.mjs",
    "payments:webhooks:listen": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/payments/stripe-listen-local.ps1",
    "payments:e2e:seed": "node scripts/payments/e2e-data.mjs seed",
    "payments:e2e:status": "node scripts/payments/e2e-data.mjs status",
    "payments:e2e:cleanup": "node scripts/payments/e2e-data.mjs cleanup",
    "test:e2e:payments:headed": "node scripts/payments/run-payments-e2e-headed.mjs",
    "zoom:video-sdk:env": "node scripts/zoom/video-sdk-env.mjs",
    "zoom:video-sdk:test": "node scripts/zoom/video-sdk-test.mjs",
    "zoom:video-sdk:webhook:smoke": "node scripts/zoom/video-sdk-webhook-smoke.mjs",
    "zoom:video-sdk:webhook:tunnel": "node scripts/zoom/video-sdk-webhook-tunnel.mjs",
    "zoom:video-sdk:webhook:real-preflight": "node scripts/zoom/video-sdk-webhook-real-preflight.mjs",
    "zoom:video-sdk:webhook:real-verify": "node scripts/zoom/video-sdk-webhook-real-verify.mjs",
    "zoom:video-sdk:api:mock": "node scripts/zoom/video-sdk-api-mock.mjs",
    "zoom:video-sdk:real-preflight": "node scripts/zoom/video-sdk-real-preflight.mjs",
    "zoom:video-sdk:emergency-end": "node scripts/zoom/video-sdk-emergency-end.mjs",
    "zoom:video-sdk:test:real": "node scripts/zoom/video-sdk-real-test.mjs",
    "test:zoom": "npm run zoom:video-sdk:test",
    "test:e2e:zoom:headed": "playwright test tests/e2e/zoom.spec.ts --headed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:deno": "deno test --config supabase/functions/deno.json --allow-env --allow-net supabase/functions/_shared/auth supabase/functions/_shared/email supabase/functions/_shared/payments supabase/functions/_shared/zoom-video-sdk supabase/functions/admin-therapy-catalog-command supabase/functions/therapist-schedule-update supabase/functions/therapist-blocks-update supabase/functions/therapist-services-command supabase/functions/therapist-profile-command supabase/functions/session-booking-checkout supabase/functions/session-reschedule",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.0",
    "@zoom/videosdk": "^2.4.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^22.3.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.21",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.23",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "postcss": "$postcss",
    "sharp": "0.35.0"
  }
}

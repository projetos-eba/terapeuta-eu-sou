    "payments:test-clock:founder:test": "node --env-file=supabase/functions/.env scripts/payments/verify-founder-test-clock.mjs",
    "payments:phase3:readiness:hml": "node scripts/payments/stripe-phase3-readiness.mjs --target=hml",
